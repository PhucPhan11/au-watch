# Copy to .env and adjust. No API keys are needed for Phase 1 sources.
PORT=3000
# Minutes between refreshes. Values below 5 are raised to 5 (Vietcombank asks for max 1 request / 5 min).
REFRESH_MINUTES=10
USER_AGENT=au-watch/0.1
# Where cache.json, history.db and scheduler.lock live. Default: ./data
# DATA_DIR=./data

# Optional source URL overrides (useful to simulate an outage, e.g. PNJ_URL=https://invalid.invalid)
# PNJ_URL=https://edge-api.pnj.io/ecom-frontend/v1/get-gold-price?zone=00
# GOLDAPI_URL=https://api.gold-api.com/price/XAU
# SWISSQUOTE_URL=https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument/XAU/USD
# VCB_URL=https://www.vietcombank.com.vn/api/exchangerates
# ERAPI_URL=https://open.er-api.com/v6/latest/USD
